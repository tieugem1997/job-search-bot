# ─── Telegram Bot ───────────────────────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your personal chat ID or group chat ID
# Get it: send a message to your bot, then visit:
# https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=your_chat_id_here

# ─── Claude AI Matching (optional but recommended) ──────────────────────────
# If set, uses claude-haiku-4-5 for accurate CV-to-job matching
# If not set, falls back to keyword scoring (still works, less accurate)
ANTHROPIC_API_KEY=sk-ant-...
